# Local development only. Set independent credentials in deployed environments.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://parrilladas:local-development-only@localhost:5432/parrilladas
POSTGRES_USER=parrilladas
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=parrilladas
POSTGRES_PORT=5432
APP_PORT=8000
API_PORT=8001
API_BASE_URL=http://127.0.0.1:8001
# LOCAL ONLY. Generate an independent random secret for the deployed API.
JWT_SECRET=local-development-signing-key-change-before-deployment
# Optional WhatsApp intake: configure all four in the API environment only.
# Leave absent to keep the webhook disabled; never commit live values.
# WHATSAPP_APP_SECRET=synthetic-local-app-secret
# WHATSAPP_VERIFY_TOKEN=synthetic-local-verification-token
# WHATSAPP_BUSINESS_ACCOUNT_ID=100000001
# WHATSAPP_PHONE_NUMBER_ID=200000001
# Optional Admin connectivity checks and public webhook address (API only).
# WHATSAPP_ACCESS_TOKEN=synthetic-local-access-token
# WHATSAPP_GRAPH_API_VERSION=v24.0
# API_PUBLIC_BASE_URL=http://localhost:8001
