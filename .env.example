# Local development only. Set independent credentials in deployed environments.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://parrilladas:local-development-only@localhost:5432/parrilladas
POSTGRES_USER=parrilladas
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=parrilladas
POSTGRES_PORT=5432
APP_PORT=8000
API_PORT=8001
API_BASE_URL=http://127.0.0.1:8001
# LOCAL ONLY. Generate an independent random secret for the deployed API.
JWT_SECRET=local-development-signing-key-change-before-deployment
# Optional WhatsApp intake: configure all four in the API environment only.
# VERIFY_TOKEN alone enables subscription verification, with intake disabled.
# Leave absent to keep both disabled; never commit live values.
# WHATSAPP_APP_SECRET=synthetic-local-app-secret
# WHATSAPP_VERIFY_TOKEN=synthetic-local-verification-token
# WHATSAPP_BUSINESS_ACCOUNT_ID=100000001
# WHATSAPP_PHONE_NUMBER_ID=200000001
# Optional Admin connectivity checks and public webhook address (API only).
# WHATSAPP_ACCESS_TOKEN=synthetic-local-access-token
# WHATSAPP_GRAPH_API_VERSION=v24.0
# API_PUBLIC_BASE_URL=http://localhost:8001
# API-wide model gate. Live messages also require the durable worker and Admin preference.
NATURAL_LANGUAGE_ENABLED=false
CONVERSATION_WORKER_ENABLED=false
# Set an aware UTC activation time before enabling the worker; older messages are not replayed.
# CONVERSATION_PROCESSING_START_AT=2026-11-15T00:00:00+00:00
# Independent one-shot connectivity check; does not enable customer-facing AI.
VERTEX_CONNECTION_ENABLED=false
# GOOGLE_SERVICE_ACCOUNT_JSON is a secret for the API service in Railway only.
# Local development uses ADC. Never copy personal ADC credentials to Railway.
# GOOGLE_CLOUD_PROJECT=your-pilot-project
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=your-verified-model-id
# ASSISTANT_TIMEOUT_MS=30000
# ASSISTANT_MAX_OUTPUT_TOKENS=512

# Approved knowledge retrieval: enable only after migration 0007 and manual ingestion.
RAG_ENABLED=false
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=us-central1
RAG_MIN_SIMILARITY=0.35

# API only. Optional: absent means new Dev grants are blocked.
# Set DEV_ROLE_KEY privately to a random 32-256 character secret; never commit its value.
